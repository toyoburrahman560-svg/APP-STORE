rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email == 'monicaeg6wbestewart@gmail.com' &&
         request.auth.token.email_verified == true)
      );
    }

    // Publicly readable approved app assets (icons, screenshots, feature graphics)
    match /public/apps/{appId}/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Published exclusively via trusted Cloud Functions on admin approval
    }

    // Approved APK downloads: require authenticated or signed URL / Cloud Function authorization
    match /public/apks/{appId}/{versionId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if false; // Moved from private staging only by backend approveApplication function
    }

    // Private developer staging uploads (APK + media before admin approval)
    match /staging/{uid}/{appId}/apk/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid)
                   && fileName.matches('.*\\.apk$')
                   && request.resource.size > 0
                   && request.resource.size <= 250 * 1024 * 1024;
    }

    match /staging/{uid}/{appId}/media/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource.size > 0
                   && request.resource.size <= 25 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|video/.*');
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
